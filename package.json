{
  "name": "dsh-local-long-horizon",
  "version": "0.1.0",
  "description": "Host-owned long-horizon task status for DeepSeek Harness local coding agents (tools + inject + STATUS.md + rightbar).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs || node -e \"console.warn('[dsh-local-long-horizon] prepare: build skipped (build toolchain unavailable); relying on prebuilt lib/')\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "long-horizon",
    "task-status",
    "agent-tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "file:../deepseek-harness/packages/core/tools"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "Jan (HagbardCeline)",
    "email": "jandareal@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
