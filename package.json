{
  "name": "dsh-local-long-horizon",
  "version": "1.0.2",
  "description": "Host-owned long-horizon task status for DeepSeek Harness local coding agents (tools + inject + STATUS.md + rightbar).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "media"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpauldahlke/dsh-local-long-horizon.git"
  },
  "homepage": "https://github.com/janpauldahlke/dsh-local-long-horizon#readme",
  "bugs": {
    "url": "https://github.com/janpauldahlke/dsh-local-long-horizon/issues"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node scripts/run-tests.mjs",
    "smoke": "npm test",
    "prepare": "node build.mjs || node -e \"console.warn('[dsh-local-long-horizon] prepare: build skipped (build toolchain unavailable); relying on prebuilt lib/')\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "cordis",
    "cordis-plugin",
    "long-horizon",
    "task-status",
    "agent-tools",
    "autonomous-agents",
    "coding-agents",
    "sidebar",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "Jan (HagbardCeline)",
    "email": "jandareal@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
